р, <i>Ich wünsche dir eine gute Nacht</i> (Я желаю тебе спокойной ночи).\\n\\nМама пожелала сыну: <b>«Gute Nacht!»</b>\\nЯ сказал всем: <b>«Gute Nacht!»</b> и пошел спать.\\n===CARD===\\n{\"submission\": \"Gute Nacht!\", \"submission_language\": \"de\", \"kind\": \"unit\", \"word\": \"Gute Nacht\", \"word_relation\": \"same\", \"suggestion\": \"\", \"meanings\": [{\"label\": \"\", \"translations\": [\"спокойной ночи\"], \"examples\": [{\"highlighted\": \"Die Mutter wünschte dem Kind <b>Gute Nacht</b>.\", \"translation\": \"Мать пожелала ребенку спокойной ночи.\"}, {\"highlighted\": \"Ich sagte allen <b>Gute Nacht</b> und ging schlafen.\", \"translation\": \"Я сказал всем спокойной ночи и пошел спать.\"}]}], \"segments\": []}'}"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":5,"unknown":0,"total":5},"items":[{"uid":"ef4c628c48a7c673","reportUrl":"https://andgineer.github.io/echo-words/builds/tests/152/index.html#testresult/ef4c628c48a7c673","status":"passed","time":{"start":1794033099689,"stop":1794033099696,"duration":7}},{"uid":"9755d96e45efb03d","reportUrl":"https://andgineer.github.io/echo-words/builds/tests/151/index.html#testresult/9755d96e45efb03d","status":"passed","time":{"start":1794032605693,"stop":1794032605702,"duration":9}},{"uid":"e7f689bfa4cbe0b6","reportUrl":"https://andgineer.github.io/echo-words/builds/tests/150/index.html#testresult/e7f689bfa4cbe0b6","status":"passed","time":{"start":1793720057972,"stop":1793720057981,"duration":9}},{"uid":"f390b32e3897e3a2","reportUrl":"https://andgineer.github.io/echo-words/builds/tests/149/index.html#testresult/f390b32e3897e3a2","status":"passed","time":{"start":1793719295780,"stop":1793719295789,"duration":9}}]},"tags":[]},"source":"64f0221fe9d12c37.json","parameterValues":["{'shot_id': 'formula-de-gute-nacht', 'lang': 'de', 'submitted': 'Gute Nacht!', 'answered_by': 'google-gemini-3.5-flash-