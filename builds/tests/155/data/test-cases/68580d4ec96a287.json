р, <i>Ich wünsche dir eine gute Nacht</i> (Я желаю тебе спокойной ночи).\\n\\nМама пожелала сыну: <b>«Gute Nacht!»</b>\\nЯ сказал всем: <b>«Gute Nacht!»</b> и пошел спать.\\n===CARD===\\n{\"submission\": \"Gute Nacht!\", \"submission_language\": \"de\", \"kind\": \"unit\", \"word\": \"Gute Nacht\", \"word_relation\": \"same\", \"suggestion\": \"\", \"meanings\": [{\"label\": \"\", \"translations\": [\"спокойной ночи\"], \"examples\": [{\"highlighted\": \"Die Mutter wünschte dem Kind <b>Gute Nacht</b>.\", \"translation\": \"Мать пожелала ребенку спокойной ночи.\"}, {\"highlighted\": \"Ich sagte allen <b>Gute Nacht</b> und ging schlafen.\", \"translation\": \"Я сказал всем спокойной ночи и пошел спать.\"}]}], \"segments\": []}'}"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":7,"unknown":0,"total":7},"items":[{"uid":"8e82b70c9b30b910","reportUrl":"https://andgineer.github.io/echo-words/builds/tests/154/index.html#testresult/8e82b70c9b30b910","status":"passed","time":{"start":1795699132515,"stop":1795699132525,"duration":10}},{"uid":"64f0221fe9d12c37","reportUrl":"https://andgineer.github.io/echo-words/builds/tests/153/index.html#testresult/64f0221fe9d12c37","status":"passed","time":{"start":1795675917971,"stop":1795675917979,"duration":8}},{"uid":"ef4c628c48a7c673","reportUrl":"https://andgineer.github.io/echo-words/builds/tests/152/index.html#testresult/ef4c628c48a7c673","status":"passed","time":{"start":1794033099689,"stop":1794033099696,"duration":7}},{"uid":"9755d96e45efb03d","reportUrl":"https://andgineer.github.io/echo-words/builds/tests/151/index.html#testresult/9755d96e45efb03d","status":"passed","time":{"start":1794032605693,"stop":1794032605702,"duration":9}},{"uid":"e7f689bfa4cbe0b6","reportUrl":"https://andgineer.github.io/echo-words/builds/tests/150/index.html#testresult/e7f689bfa4cbe0b6","status":"passed","time":{"start":1793720057972,"