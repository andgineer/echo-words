римирения с неблагоприятным положением дел. Часто сопровождается вздохом или пожиманием плечами.\\n\\n— Мы опоздали на поезд. — <b>Oh, well</b>, придется ехать на следующем.\\n<b>Oh, well</b>, я попытался, но у меня ничего не вышло.\\n— План сорвался. — <b>Oh, well</b>, бывает и хуже.\\n\\n===CARD===\\n{\"submission\": \"Oh, well\", \"submission_language\": \"en\", \"kind\": \"unit\", \"word\": \"oh, well\", \"word_relation\": \"same\", \"suggestion\": \"\", \"meanings\": [{\"label\": \"acceptance\", \"translations\": [\"ну что ж\", \"ладно\", \"ничего не поделаешь\"], \"examples\": [{\"highlighted\": \"<b>Oh, well</b>, we will just have to try again tomorrow.\", \"translation\": \"Ну что ж, нам просто придется попробовать снова завтра.\"}, {\"highlighted\": \"<b>Oh, well</b>, it was worth a shot.\", \"translation\": \"Ничего не поделаешь, это стоило попытки.\"}]}], \"segments\": [{\"label\": \"oh\", \"surface\": \"Oh\", \"why\": \"выражает эмоциональную реакцию или досаду\"}, {\"label\": \"well\", \"surface\": \"well\", \"why\": \"служит для смягчения ситуации или перехода к принятию\"}]}'}"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":4,"unknown":0,"total":4},"items":[{"uid":"82bf917fe235ce4","reportUrl":"https://andgineer.github.io/echo-words/builds/tests/153/index.html#testresult/82bf917fe235ce4","status":"passed","time":{"start":1795675908651,"stop":1795675908654,"duration":3}},{"uid":"2419bdcc2e55d984","reportUrl":"https://andgineer.github.io/echo-words/builds/tests/152/index.html#testresult/2419bdcc2e55d984","status":"passed","time":{"start":1794033091553,"stop":1794033091554,"duration":1}},{"uid":"ae1e35b10973b12f","reportUrl":"https://andgineer.github.io/echo-words/builds/tests/151/index.html#testresult/ae1e35b10973b12f","status":"passed","time":{"start":1794032599627,"stop":1794032599628,"duration":1}}]},"tags":[]},"source":"e418b7ef170